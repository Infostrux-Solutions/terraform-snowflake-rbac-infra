{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateBucketReadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketVersioning",
        "s3:GetBucketAcl",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::infx-dev-terraform-state-us-west-2"
    },
    {
      "Sid": "TerraformStateObjectReadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::infx-dev-terraform-state-us-west-2/*"
    }
  ]
}


